@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section with Animation -->
<div class="hero-section">
    <div class="hero-background">
        <div class="gradient-overlay"></div>
        <div class="animated-shapes">
            <div class="shape shape-1"></div>
            <div class="shape shape-2"></div>
            <div class="shape shape-3"></div>
        </div>
    </div>

    <div class="hero-content">
        <div class="welcome-container">
            <div class="logo-animation">
                <div class="logo-icon">💪</div>
                <h1 class="display-3 app-title">FitnessTracker</h1>
            </div>
            <p class="lead tagline">
                Transform Your Body, Elevate Your Life
            </p>
            <p class="subtitle">
                Complete Fitness & Health Management Platform
            </p>

           @*  <div class="status-badge">
                <span class="badge-dot"></span>
                <span class="badge-text">V1.0 Complete — Full Featured Application</span>
            </div> *@

            <!-- Animated Fitness Icons -->
            <div class="fitness-icon-container">
                <div class="fitness-icon icon-1" title="Yoga & Meditation">🧘</div>
                <div class="fitness-icon icon-2" title="Cardio Training">🏃</div>
                <div class="fitness-icon icon-3" title="Strength Training">🏋️</div>
                <div class="fitness-icon icon-4" title="Nutrition">🥗</div>
                <div class="fitness-icon icon-5" title="Analytics">📊</div>
            </div>

            <!-- CTA Buttons -->
            <div class="cta-buttons">
                @if (SessionHelper.IsLoggedIn(Context.Session))
                {
                    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-hero btn-primary">
                        <span class="btn-icon">📊</span>
                        Go to Dashboard
                    </a>
                    <a asp-controller="Workout" asp-action="Index" class="btn btn-hero btn-outline">
                        <span class="btn-icon">🏋️</span>
                        My Workouts
                    </a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Register" class="btn btn-hero btn-primary">
                        <span class="btn-icon">🚀</span>
                        Get Started Free
                    </a>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-hero btn-outline">
                        <span class="btn-icon">🔑</span>
                        Sign In
                    </a>
                }
            </div>
        </div>
    </div>

    <!-- Scroll Indicator -->
    <div class="scroll-indicator">
        <div class="mouse">
            <div class="wheel"></div>
        </div>
        <p>Scroll to explore</p>
    </div>
</div>

<!-- Features Section -->
<div class="features-section">
    <div class="container">
        <div class="section-header">
            <h2 class="section-title">✨ Powerful Features</h2>
            <p class="section-subtitle">Everything you need to achieve your fitness goals</p>
        </div>

        <div class="features-grid">
            <!-- Feature 1: Workout Tracking -->
            <div class="feature-card card-workout">
                <div class="feature-icon">🏋️</div>
                <h3 class="feature-title">Workout Tracking</h3>
                <p class="feature-description">
                    Log and track your exercises with detailed metrics including sets, reps, weight, and duration.
                </p>
                <ul class="feature-list">
                    <li>✓ Multiple exercise types</li>
                    <li>✓ Progress tracking</li>
                    <li>✓ Custom workout plans</li>
                </ul>
                @if (SessionHelper.IsLoggedIn(Context.Session))
                {
                    <a asp-controller="Workout" asp-action="Index" class="feature-link">
                        Start Workout →
                    </a>
                }
            </div>

            <!-- Feature 2: Meal Planning -->
            <div class="feature-card card-nutrition">
                <div class="feature-icon">🍽️</div>
                <h3 class="feature-title">Meal Planning</h3>
                <p class="feature-description">
                    Track your nutrition intake and manage your diet with comprehensive meal logging.
                </p>
                <ul class="feature-list">
                    <li>✓ Calorie tracking</li>
                    <li>✓ Macro breakdown</li>
                    <li>✓ Meal history</li>
                </ul>
                @if (SessionHelper.IsLoggedIn(Context.Session))
                {
                    <a asp-controller="Meal" asp-action="Index" class="feature-link">
                        Plan Meals →
                    </a>
                }
            </div>

            <!-- Feature 3: BMI Calculator -->
            <div class="feature-card card-calculator">
                <div class="feature-icon">📏</div>
                <h3 class="feature-title">BMI Calculator</h3>
                <p class="feature-description">
                    Calculate your Body Mass Index and get personalized health recommendations.
                </p>
                <ul class="feature-list">
                    <li>✓ Instant BMI calculation</li>
                    <li>✓ Health status analysis</li>
                    <li>✓ Category breakdown</li>
                </ul>
                <a asp-controller="Calculator" asp-action="BMI" class="feature-link">
                    Calculate BMI →
                </a>
            </div>

            <!-- Feature 4: Calorie Calculator -->
            <div class="feature-card card-calorie">
                <div class="feature-icon">🔥</div>
                <h3 class="feature-title">Calorie Calculator</h3>
                <p class="feature-description">
                    Determine your daily caloric needs based on your goals and activity level.
                </p>
                <ul class="feature-list">
                    <li>✓ BMR & TDEE calculation</li>
                    <li>✓ Macro recommendations</li>
                    <li>✓ Goal-based planning</li>
                </ul>
                <a asp-controller="Calculator" asp-action="Calorie" class="feature-link">
                    Calculate Calories →
                </a>
            </div>

            <!-- Feature 5: Analytics Dashboard -->
            <div class="feature-card card-analytics">
                <div class="feature-icon">📊</div>
                <h3 class="feature-title">Progress Analytics</h3>
                <p class="feature-description">
                    Visualize your fitness journey with comprehensive charts and statistics.
                </p>
                <ul class="feature-list">
                    <li>✓ Interactive charts</li>
                    <li>✓ Workout statistics</li>
                    <li>✓ Calorie insights</li>
                </ul>
                @if (SessionHelper.IsLoggedIn(Context.Session))
                {
                    <a asp-controller="Dashboard" asp-action="Index" class="feature-link">
                        View Dashboard →
                    </a>
                }
            </div>

            <!-- Feature 6: Profile Management -->
            <div class="feature-card card-profile">
                <div class="feature-icon">👤</div>
                <h3 class="feature-title">Profile Management</h3>
                <p class="feature-description">
                    Manage your personal information and track your fitness metrics over time.
                </p>
                <ul class="feature-list">
                    <li>✓ Personal details</li>
                    <li>✓ Body measurements</li>
                    <li>✓ Goal setting</li>
                </ul>
                @if (SessionHelper.IsLoggedIn(Context.Session))
                {
                    <a asp-controller="Account" asp-action="Profile" class="feature-link">
                        Edit Profile →
                    </a>
                }
            </div>
        </div>
    </div>
</div>

<!-- Stats Section -->
<div class="stats-section">
    <div class="container">
        <div class="stats-grid">
            <div class="stat-item">
                <div class="stat-icon">💪</div>
                <div class="stat-number" data-target="1000">0</div>
                <div class="stat-label">Active Users</div>
            </div>
            <div class="stat-item">
                <div class="stat-icon">🏋️</div>
                <div class="stat-number" data-target="5000">0</div>
                <div class="stat-label">Workouts Logged</div>
            </div>
            <div class="stat-item">
                <div class="stat-icon">🍽️</div>
                <div class="stat-number" data-target="10000">0</div>
                <div class="stat-label">Meals Tracked</div>
            </div>
            <div class="stat-item">
                <div class="stat-icon">🎯</div>
                <div class="stat-number" data-target="750">0</div>
                <div class="stat-label">Goals Achieved</div>
            </div>
        </div>
    </div>
</div>

<!-- How It Works Section -->
<div class="how-it-works-section">
    <div class="container">
        <div class="section-header">
            <h2 class="section-title">🚀 How It Works</h2>
            <p class="section-subtitle">Get started in three simple steps</p>
        </div>

        <div class="steps-container">
            <div class="step-item">
                <div class="step-number">1</div>
                <div class="step-icon">📝</div>
                <h3 class="step-title">Create Account</h3>
                <p class="step-description">
                    Sign up for free and set up your personalized profile with your fitness goals.
                </p>
            </div>

            <div class="step-connector"></div>

            <div class="step-item">
                <div class="step-number">2</div>
                <div class="step-icon">🎯</div>
                <h3 class="step-title">Set Your Goals</h3>
                <p class="step-description">
                    Define your fitness objectives and get personalized calorie and macro recommendations.
                </p>
            </div>

            <div class="step-connector"></div>

            <div class="step-item">
                <div class="step-number">3</div>
                <div class="step-icon">📈</div>
                <h3 class="step-title">Track & Progress</h3>
                <p class="step-description">
                    Log your workouts and meals daily, and watch your progress through analytics.
                </p>
            </div>
        </div>
    </div>
</div>

<!-- CTA Section -->
<div class="cta-section">
    <div class="container">
        <div class="cta-content">
            <h2 class="cta-title">Ready to Transform Your Life?</h2>
            <p class="cta-description">
                Join thousands of users who are already achieving their fitness goals with FitnessTracker
            </p>
            @if (!SessionHelper.IsLoggedIn(Context.Session))
            {
                <a asp-controller="Account" asp-action="Register" class="btn btn-cta">
                    <span class="btn-icon">🚀</span>
                    Start Your Journey Now
                </a>
            }
            else
            {
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-cta">
                    <span class="btn-icon">📊</span>
                    Continue Your Journey
                </a>
            }
        </div>
    </div>
</div>

<style>
    /* Hero Section */
    .hero-section {
        position: relative;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }

    .hero-background {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
    }

    .gradient-overlay {
        position: absolute;
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg, rgba(102, 126, 234, 0.9) 0%, rgba(118, 75, 162, 0.9) 100%);
    }

    .animated-shapes {
        position: absolute;
        width: 100%;
        height: 100%;
    }

    .shape {
        position: absolute;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 50%;
        animation: float 20s infinite;
    }

    .shape-1 {
        width: 300px;
        height: 300px;
        top: 10%;
        left: 10%;
        animation-delay: 0s;
    }

    .shape-2 {
        width: 200px;
        height: 200px;
        top: 60%;
        right: 15%;
        animation-delay: 5s;
    }

    .shape-3 {
        width: 150px;
        height: 150px;
        bottom: 20%;
        left: 50%;
        animation-delay: 10s;
    }

    .hero-content {
        position: relative;
        z-index: 2;
        text-align: center;
        padding: 40px 20px;
    }

    .welcome-container {
        max-width: 800px;
        margin: 0 auto;
    }

    .logo-animation {
        margin-bottom: 20px;
        animation: fadeInDown 1s ease-out;
    }

    .logo-icon {
        font-size: 5rem;
        margin-bottom: 10px;
        animation: bounce 2s infinite;
    }

    .app-title {
        color: white;
        font-weight: 800;
        font-size: 4rem;
        margin: 0;
        text-shadow: 0 4px 10px rgba(0,0,0,0.2);
        letter-spacing: -2px;
    }

    .tagline {
        color: rgba(255, 255, 255, 0.95);
        font-size: 1.8rem;
        margin: 15px 0 10px;
        font-weight: 300;
        animation: fadeIn 1.5s ease-out;
    }

    .subtitle {
        color: rgba(255, 255, 255, 0.8);
