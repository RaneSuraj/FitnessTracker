        font-size: 1.2rem;
        font-weight: 700;
        background: white;
        color: #1e293b;
        border-radius: 50px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 12px;
        transition: all 0.3s ease;
