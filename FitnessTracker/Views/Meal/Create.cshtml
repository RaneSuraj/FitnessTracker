@model FitnessTracker.Models.Meal
@{
    ViewData["Title"] = "Log Meal";
    var meals = ViewBag.MealOptions as List<FitnessTracker.Models.MealOption>;
}

<div class="form-container">
    <div class="form-card">
        <div class="form-header">
            <h2>🍽️ Log Meal</h2>
            <p class="text-muted">Select a meal or create your own</p>
        </div>

        <form method="post" id="mealForm">
            <!-- Meal Type Filter -->
            <div class="meal-type-filter">
                <button type="button" class="filter-btn active" data-type="All">All</button>
                <button type="button" class="filter-btn" data-type="Breakfast">Breakfast</button>
                <button type="button" class="filter-btn" data-type="Lunch">Lunch</button>
                <button type="button" class="filter-btn" data-type="Dinner">Dinner</button>
                <button type="button" class="filter-btn" data-type="Snack">Snack</button>
            </div>

            <!-- Meal Selection Grid -->
            <div class="meal-selection">
                <h4>Select Meal</h4>
                <div class="meal-grid" id="mealGrid">
                    @foreach (var meal in meals)
                    {
                        <div class="meal-option"
                             data-name="@meal.Name"
                             data-type="@meal.MealType"
                             data-calories="@meal.Calories"
                             data-protein="@meal.Protein"
                             data-carbs="@meal.Carbs"
                             data-fat="@meal.Fat"
                             data-is-custom="@(meal.Name == "Other" ? "true" : "false")">
                            <div class="meal-icon">@meal.Icon</div>
                            <div class="meal-name">@meal.Name</div>
                            @if (meal.Name != "Other")
                            {
                                <div class="meal-meta">@meal.Calories cal</div>
                            }
                        </div>
                    }
                </div>
            </div>

            <input type="hidden" name="selectedMeal" id="selectedMeal" />
            <input type="hidden" name="isCustom" id="isCustom" value="false" />

            <!-- Custom Meal Name (shown when "Other" is selected) -->
            <div class="form-group" id="customNameGroup" style="display: none;">
                <label asp-for="Name">Meal Name</label>
                <input asp-for="Name" class="form-control" placeholder="e.g., Homemade Salad" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <!-- Meal Type Selection (shown when "Other" is selected) -->
            <div class="form-group" id="customTypeGroup" style="display: none;">
                <label asp-for="MealType">Meal Type</label>
                <select asp-for="MealType" class="form-control">
                    <option value="">Select Type</option>
                    <option value="Breakfast">Breakfast</option>
                    <option value="Lunch">Lunch</option>
                    <option value="Dinner">Dinner</option>
                    <option value="Snack">Snack</option>
                </select>
                <span asp-validation-for="MealType" class="text-danger"></span>
            </div>

            <!-- Nutrition Details -->
            <div class="nutrition-section">
                <h4>Nutrition Information</h4>

                <div class="form-row">
                    <div class="form-group col-md-6">
                        <label asp-for="Calories">Calories</label>
                        <input asp-for="Calories" type="number" class="form-control" id="caloriesInput" placeholder="e.g., 350" />
                        <span asp-validation-for="Calories" class="text-danger"></span>
                    </div>

                    <div class="form-group col-md-6">
                        <label asp-for="Protein">Protein (g)</label>
                        <input asp-for="Protein" type="number" step="0.1" class="form-control" id="proteinInput" placeholder="e.g., 25" />
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group col-md-6">
                        <label asp-for="Carbs">Carbs (g)</label>
                        <input asp-for="Carbs" type="number" step="0.1" class="form-control" id="carbsInput" placeholder="e.g., 45" />
                    </div>

                    <div class="form-group col-md-6">
                        <label asp-for="Fat">Fat (g)</label>
                        <input asp-for="Fat" type="number" step="0.1" class="form-control" id="fatInput" placeholder="e.g., 12" />
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="MealDate">Meal Date</label>
                <input asp-for="MealDate" type="date" class="form-control" />
                <span asp-validation-for="MealDate" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description">Notes (Optional)</label>
                <textarea asp-for="Description" class="form-control" rows="3" placeholder="Add any notes about this meal..."></textarea>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-success">Log Meal</button>
                <a href="/Meal/Index" class="btn btn-outline">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        let selectedMealName = '';
        let isCustomMeal = false;

        // Meal type filter
        document.querySelectorAll('.filter-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
                this.classList.add('active');

                const filterType = this.getAttribute('data-type');
                const mealOptions = document.querySelectorAll('.meal-option');

                mealOptions.forEach(option => {
                    const mealType = option.getAttribute('data-type');
                    if (filterType === 'All' || mealType === filterType || mealType === 'Custom') {
                        option.style.display = 'flex';
                    } else {
                        option.style.display = 'none';
                    }
                });
            });
        });

        // Meal selection
        document.querySelectorAll('.meal-option').forEach(option => {
            option.addEventListener('click', function() {
                // Remove previous selection
                document.querySelectorAll('.meal-option').forEach(opt => opt.classList.remove('selected'));

                // Mark as selected
                this.classList.add('selected');

                // Get meal data
                selectedMealName = this.getAttribute('data-name');
                isCustomMeal = this.getAttribute('data-is-custom') === 'true';

                document.getElementById('selectedMeal').value = selectedMealName;
                document.getElementById('isCustom').value = isCustomMeal;

                // Show/hide custom fields
                if (isCustomMeal) {
                    document.getElementById('customNameGroup').style.display = 'block';
                    document.getElementById('customTypeGroup').style.display = 'block';
                    // Clear auto-filled values
                    document.getElementById('caloriesInput').value = '';
                    document.getElementById('proteinInput').value = '';
                    document.getElementById('carbsInput').value = '';
                    document.getElementById('fatInput').value = '';
                } else {
                    document.getElementById('customNameGroup').style.display = 'none';
                    document.getElementById('customTypeGroup').style.display = 'none';
                    // Auto-fill nutrition data
                    document.getElementById('caloriesInput').value = this.getAttribute('data-calories');
                    document.getElementById('proteinInput').value = this.getAttribute('data-protein');
                    document.getElementById('carbsInput').value = this.getAttribute('data-carbs');
                    document.getElementById('fatInput').value = this.getAttribute('data-fat');
                }
            });
        });

        // Form validation
        document.getElementById('mealForm').addEventListener('submit', function(e) {
            if (!selectedMealName) {
                e.preventDefault();
                alert('Please select a meal');
            }
        });
    </script>
}